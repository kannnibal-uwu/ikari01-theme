! Base16 Ikari-01
! Scheme author: kannnibal
! Template author: Tinted Theming (https://github.com/tinted-theming)

! base00: #1d1a2f
! base01: #342455
! base02: #3e2c64
! base03: #5a4984
! base04: #68578b
! base05: #dac2ff
! base06: #f2e5ff
! base07: #e3d1ff
! base08: #be5e13
! base09: #984d14
! base0A: #c79128
! base0B: #319742
! base0C: #3cd3a0
! base0D: #61a5ff
! base0E: #e14dff
! base0F: #4c3b77

! Enable the extended coloring options
rofi.color-enabled: true

! Property Name     BG       Border   Separator
rofi.color-window:  #342455, #342455, #1d1a2f

! Property Name     BG       FG       BG-alt   Head-BG  Head-FG
rofi.color-normal:  #342455, #dac2ff, #342455, #342455, #e3d1ff
rofi.color-active:  #342455, #61a5ff, #342455, #342455, #61a5ff
rofi.color-urgent:  #342455, #be5e13, #342455, #342455, #be5e13

! Set the desired separator style
rofi.separator-style: solid
